{
    "multipart":  [
                      {
                          "apply":  {
                                        "model":  "gungang:block/blue_jump_pad"
                                    }
                      },
                      {
                          "when":  {
                                       "north":  "false"
                                   },
                          "apply":  {
                                        "model":  "gungang:block/blue_jump_pad_edge",
                                        "y":  0
                                    }
                      },
                      {
